# Supabase project → Settings → API. Publishable/anon key only — never the service_role key.
# Leave blank to run in demo mode (counters stored in this browser only).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side only, for scripts/increment-activity.mjs (also set as GitHub Actions secrets
# SUPABASE_URL + SUPABASE_SECRET_KEY). Never prefix with VITE_ — that would ship it to browsers.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
